# (SISTEMA DE PLANEJAMENTO DE ROTINA) #

print("===== AVALIAÇÃO DA ROTINA DIÁRIA =====")

pontuacao = 0

# Descanso #
print("\n ====== DESCANSO ======")
sono_noite = int(input("Informe quantas horas você dorme por noite (h): "))
repouso_dia = int(input("Informe quantas horas você descansa durante o dia (h): "))

if sono_noite >= 7:
    pontuacao += 2
elif sono_noite >= 5:
    pontuacao += 1

if repouso_dia >= 1:
    pontuacao += 1

# Atividade Física #
print("\n ====== ATIVIDADE FÍSICA ======")
pratica = input("Você tem hábito de praticar atividade física (sim/não): ").lower()
if pratica == "sim":
        pontuacao += 2
        
        atividade = input("Tipo de atividade física que você pratica (academia; caminhada; dança; esporte): ").lower()
        dias = int(input("Informe quantos dias por semana você pratica essa atividade: "))
        if dias >= 3:
          pontuacao += 2
        else:
          pontuacao += 1

elif pratica == "não":
    tempo = input("Está há mais de 3 meses sem praticar atividade física (sim/não): ").lower()
    if tempo == "sim":
        pontuacao -= 2
    else:
        pontuacao -= 1

# Atividades Diárias #
trabalho = input("Atualmente você está trabalhando (sim/não): ").lower()
if trabalho == "sim":
    pontuacao += 2

horas = int(input("Informe as horas de trabalho por dia (h): "))
if horas >= 7:
    pontuacao += 2

estudo = input("Atualmente você está estudando (sim/não): ").lower()
if estudo == "sim":
    pontuacao += 2

estudo_casa = int(input("Horas de estudo em casa: "))
if estudo_casa >= 1:
    pontuacao += 1

# Atividades Variadas #
projeto = input("Está trabalhando em algum projeto (sim/não): ").lower()
if projeto == "sim":
    pontuacao += 2

leitura = input("Está lendo algum livro (sim/não): ").lower()
if leitura == "sim":
    pontuacao += 1

lazer = input("Costuma sair aos fins de semana ou feriado (sim/não): ").lower()
if lazer == "sim":
    pontuacao += 1

# Resultado #
print("\n ====== RESULTADO FINAL ======")
print(f"Pontuação: {pontuacao}")

if pontuacao >= 10:
    print("ROTINA MUITO EQUILIBRADA E ORGANIZADA")
elif pontuacao >= 7:
    print("ROTINA EQUILIBRADA, MAS COM DESAFIOS")
elif pontuacao >= 5:
    print("ROTINA SOBRECARREGADA, PRECISA DE AJUSTES")
else:
    print("ATENÇÃO: DIMINUA O RITMO E A CARGA DE ATIVIDADES!")


