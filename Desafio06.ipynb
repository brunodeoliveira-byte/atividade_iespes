# (SISTEMA DE AVALIAÇÃO DE DE TOMADA DE DECISÃO) #

print("\n #====== AVALIAÇÃO DE TOMADA DE DECISÃO ======#")

pontuacao = 0

# CONSEQUÊNCIA #
decisao = input("Informe a decisão que você deseja avaliar: ")

decisao = input("Essa decisão é uma escolha pessoal ou surgiu de pressão além de você: ").lower()
if decisao == "escolha pessoal":
    pontuacao += 2
elif decisao == "medio":
    pontuacao += 1

beneficio = input("O benefício dessa decisão pode ser considerado alto/medio/baixo: ").lower()
if beneficio == "alto":
    pontuacao += 2
elif beneficio == "medio":
    pontuacao += 1


qualidade = input("Essa decisão tem poder para melhorar sua vida (sim/não): ").lower()
if qualidade == "sim":
    pontuacao += 2

# CUSTO e RISCO #
impacto = input("Essa decisão pode ser considerada um investimento ou um gasto: ").lower()
if impacto == "investimento":
  pontuacao += 2

  custo = input("Mesmo sendo investimento, o custo pode ser considerado alto/medio/baixo: ").lower()
  if custo == "alto":
    pontuacao -= 2
  elif custo == "medo":
    pontuacao -= 1

elif impacto == "gasto":
  pontuacao -= 2

preciptacao = input("Você teve tempo para refletir antes de decidir (sim/não): ").lower()
if preciptacao == "não":
    pontuacao -= 2

informacao = input("Você possui informações suficientes para essa decisão (sim/não): ").lower()
if informacao == "sim":
    pontuacao += 2
else:
    pontuacao -= 2

reversivel = input("Essa descisão pode ser revertida caso dê errado (sim/não): ").lower()
if reversivel == "sim":
    pontuacao += 2
else:
    pontuacao -= 2

risco =  input("No pior cenário possível, essa decisão lhe prejudica muito (sim/não): ").lower()
if risco == "sim":
    pontuacao -= 2

#CONTEXTO SOCIAL, ALINHAMENTO E ESTRATÉGIA#

emocional = input("Você está emocionalmente estável em relação à essa decisão (sim/não): ").lower()
if emocional == "sim":
    pontuacao += 2
else:
    pontuacao -= 2

critica = input("As críticas que você recebeu são fundamentadas e construtivas (sim/não): ").lower()
if critica == "sim":
    pontuacao += 2

apoio = input("Pessoas confiáveis e experientes apoiam sua decisão (sim/não): ").lower()
if apoio == "sim":
    pontuacao += 2

objetivo = input("Essa decisão contribui para o seu objetivo principal (totalmente/parcialmente/não)")
if objetivo == "totalmente":
    pontuacao += 2
elif objetivo == "parcialmente":
    pontuacao += 1

alternativas = input("Você considerou outras alternativas antes de optar por essa decisão (sim/não): ").lower()
if alternativas == "sim":
    pontuacao += 2
else:
    pontuacao -= 2

print("\n #===== RESULTADO ======#")

print(f"Decisão Analisada: {decisao}")
print(f"Pontuação Alcançada: {pontuacao}")

if pontuacao >= 8:
    print("DECISÃO MUITO FAVORÁVEL!")
elif pontuacao >= 5:
    print("DECISÃO FAVORÁVEL!")
elif pontuacao >= 3:
    print("AVALIE MELHOR O CENÁRIO!!")
    print("PONDERE SOBRE O QUE É NECESSÁRIO ACRESCENTAR, DESCARTAR OU AJUSTAR!!")
else:
    print("DECISÃO ARRISCADA!")
    print("REVISE O PLANO!")
    print("CONSIDERE AGUARDAR UM MOMENTO MAIS OPORTUNO!!")
